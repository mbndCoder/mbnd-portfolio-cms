# =====================================================================
# Environment Configuration Template — Personal Portfolio & Blog CMS
# Serverless-Ready for Vercel + Turso (libSQL) + Cloudinary
# Copy this file to `.env` locally or add these keys in Vercel Project Settings.
# Never commit your real `.env` file or `data/` directory to Git.
# =====================================================================

# Public canonical domain used for SEO, OpenGraph, Sitemap, llms.txt, and vCard
APP_URL="https://mbnd.ir"

# HTTP listening port for local development (ignored on Vercel Serverless)
APP_PORT="3000"

# Runtime environment: "production" on Vercel/live servers, "development" locally
NODE_ENV="production"

# ==================== TURSO (libSQL) DATABASE ====================
# Required on Vercel Serverless (100% Free Tier at https://turso.tech)
# Example: LIBSQL_URL="libsql://your-database-name-your-org.turso.io"
# Note: Locally, if left empty, falls back to embedded file:./data/site.db
LIBSQL_URL=""
LIBSQL_AUTH_TOKEN=""

# ==================== CLOUDINARY MEDIA STORAGE ====================
# Required for uploading images, videos, audio, and PDFs (100% Free Tier at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional folder prefix inside your Cloudinary media library (default: mbnd-uploads)
CLOUDINARY_FOLDER="mbnd-uploads"

# ==================== SECRET ADMIN PORTAL & AUTH ====================
# Secret URL slug for the Admin Portal (without a leading slash).
# Example: ADMIN_ROUTE="manage-portal-x7k9"
# Security note: If left empty, the Admin Portal and its auth APIs stay disabled.
ADMIN_ROUTE=""

# Optional initial admin credentials (leave blank to create your account via
# the one-time First-Run Setup screen when you first visit /<ADMIN_ROUTE>).
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Optional pre-hashed scrypt password ("salt:hex_hash") instead of plaintext:
# ADMIN_PASSWORD_HASH=""

# Recommended 64-character hex secret for signing HttpOnly session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a random secret is auto-generated and stored in Turso.
SESSION_SECRET=""
