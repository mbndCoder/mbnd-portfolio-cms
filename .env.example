# ==============================================================================
# Application & Runtime Settings
# ==============================================================================
# Runtime environment: "development" for local dev, "production" for deployment
NODE_ENV=

# Local server listening port (default: 3000; not needed on Cloudflare Workers)
APP_PORT=

# Public canonical site URL without trailing slash (e.g. https://yourdomain.com)
# Used for SEO canonical links, OpenGraph URLs, sitemap.xml, rss.xml, and vCard
APP_URL=

# ==============================================================================
# Database — Turso / libSQL (Required for Cloudflare Workers; optional locally)
# If left empty locally, the app automatically falls back to ./data/site.db
# ==============================================================================
# Your Turso database URL (e.g. libsql://your-db-name-org.turso.io)
LIBSQL_URL=

# Turso database authentication token
LIBSQL_AUTH_TOKEN=

# ==============================================================================
# Admin Portal & Security
# ==============================================================================
# Secret URL slug to access the Admin Portal without leading slash (e.g. my-panel-x92)
# Leave empty to keep the Admin Portal disabled
ADMIN_ROUTE=

# Optional: Pre-seed initial admin username & password.
# Recommended: Leave both empty and use the one-time setup form on first visit.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret key for signing admin session tokens & encrypting saved AI API keys (32+ random chars)
# If omitted, a random secret is generated and persisted in the database automatically
SESSION_SECRET=

# ==============================================================================
# Media Uploads — Cloudinary (Required for image/video/audio uploads on Edge)
# ==============================================================================
# Your Cloudinary Cloud Name
CLOUDINARY_CLOUD_NAME=

# Cloudinary API Key
CLOUDINARY_API_KEY=

# Cloudinary API Secret (keep strictly private on the server)
CLOUDINARY_API_SECRET=

# Folder name inside Cloudinary where uploaded media will be organized (default: site-uploads)
CLOUDINARY_FOLDER=